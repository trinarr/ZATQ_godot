    "street_decision": {
      "source": "NewItem(3); NewItem.But1/2/3MouseUpFunc",
      "text": "Что же Джеку предпринять дальше? Добраться таки до офиса или лучше уехать из города?",
      "image": "Fon1_1.png",
      "kind": "city_decision",
      "art": "city_street_stretcher",
      "back": "street_stretcher",
      "choices": [
        {
          "text": "Идти в офис дворами",
